# The Xcode project is generated from ios/project.yml by xcodegen. Never edit it by hand,
# never commit it -- the spec is the source of truth.
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
build/
.swiftpm/
.build/
Package.resolved
*.xcarchive
*.ipa

# Secrets. Base.xcconfig and Secrets.xcconfig.example ARE committed; this is not.
ios/Quokka/Secrets.xcconfig
.env
.env.*
!.env.example

# Node (mcp/ and tools/)
node_modules/
*.tsbuildinfo

# A real Instagram export is the user's own data and never belongs in the repo.
# Redacted fixtures live in ios/QuokkaDesign/Tests/Fixtures/ and are committed.
tools/export/
*.zip

# macOS
.DS_Store

# Next build output (was tracked by mistake)
web/.next/
web/out/

# Keep on Truckin is licensed for personal use only. It stays on disk for private
# builds and never enters the repo or the app bundle -- see docs/TESTFLIGHT.md.
ios/Quokka/Resources/Fonts/KeeponTruckin.ttf

# Worker secrets. .dev.vars.example IS committed; the real one never is.
backend/worker/.dev.vars
backend/worker/.wrangler/
